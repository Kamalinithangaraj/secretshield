# GitHub OAuth application
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback

# GitHub App authentication
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY_PATH=secrets/your-private-key.pem

# Session security — replace with a long random value
SECRET_KEY=replace_with_a_secure_random_value

# Set to 1 when deployed behind HTTPS
SECRET_SHIELD_HTTPS=0
# Secret fingerprinting — generate a unique random key
SECRET_SHIELD_FINGERPRINT_KEY=replace_with_a_secure_random_value
